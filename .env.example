# Every key src/config/env.ts reads. Blank means "not configured", which
# is a valid state for everything below the required block — the platform
# degrades honestly rather than failing to boot.

# --- required ---
DATABASE_URL=postgresql://hason:hason@localhost:5432/hason
PAYLOAD_SECRET=replace-with-strong-secret
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- local development only ---
TEST_DATABASE_URL=postgresql://hason:hason@localhost:5433/hason_test
DEMO_CONTENT=false
# Schema sync without migrations. Refused at boot under NODE_ENV=production.
# See docs/Adopting-Migrations.md before changing this anywhere real.
PAYLOAD_DB_PUSH=false

# --- draft preview (disabled when blank) ---
PREVIEW_SECRET=replace-with-preview-secret

# --- passwordless participant links (falls back to PAYLOAD_SECRET) ---
REGISTRATION_LINK_SECRET=

# --- email delivery ---
# SMTP_HOST and SMTP_FROM together are the minimum that can send. Leave
# both blank and the platform records messages without delivering them.
# See docs/Email-Delivery.md.
SMTP_HOST=
SMTP_PORT=587
# blank: implicit TLS on 465, STARTTLS elsewhere
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REPLY_TO=
# Bearer token for the cron that retries the outbox: openssl rand -base64 32
DISPATCH_SECRET=

# --- media storage (local disk when blank) ---
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- monday.com integration (disabled when blank) ---
MONDAY_API_TOKEN=
MONDAY_BOARD_ID=

# --- break-glass access to the Payload panel in production ---
CONTENT_ENGINE_ADMIN=false
PAYLOAD_ADMIN=false

# --- branding ---
# The support mailbox shown to a stuck guest. Set when the Netaim
# mailbox is live; defaults to the address that currently receives mail.
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- the platform's own tenant row (first boot only) ---
# The slug is a stored key: changing it on an existing database creates a
# second organization rather than renaming the first.
PLATFORM_ORG_NAME=
PLATFORM_ORG_SLUG=

# --- logging ---
LOG_DIR=
