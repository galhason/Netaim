{
  "name": "hason-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "_migrations:README": "STOP. This database was built with PAYLOAD_DB_PUSH, so it has no migration history. `migrate:create` will therefore emit a BASELINE of all 78 tables, and `migrate` will then fail on the first CREATE TABLE because they already exist. Adopting migrations needs the baseline recorded as already-applied first — see docs/Adopting-Migrations.md. Until then, local schema changes go through PAYLOAD_DB_PUSH=true in dev.",
    "migrate:create": "payload migrate:create",
    "migrate": "payload migrate",
    "migrate:status": "payload migrate:status",
    "retention:status": "node scripts/retention.mjs",
    "retention:purge": "node scripts/retention.mjs --purge",
    "why:directory": "node scripts/why-not-in-directory.mjs",
    "carry:profiles": "node scripts/carry-profiles-to-accounts.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "docker compose up -d postgres-test && TEST_DATABASE_URL=postgres://hason:hason@localhost:5433/hason_test vitest run tests/integration",
    "gates": "npm run generate:types && npm run typecheck && npm run lint && npm run test && npm run build",
    "setup:verification": "node scripts/setup-verification-table.mjs"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.0.0",
    "@payloadcms/next": "^3.0.0",
    "@payloadcms/richtext-lexical": "^3.0.0",
    "@payloadcms/storage-s3": "^3.86.0",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "next": "~15.4.11",
    "next-intl": "^4.0.0",
    "nodemailer": "^6.9.0",
    "payload": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-qr-code": "^2.2.0",
    "sharp": "^0.34.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "~15.4.11",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
